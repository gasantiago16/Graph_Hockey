# xAI (default both benches; required for live xAI matches; not required for --no-llm / CI)
XAI_API_KEY=
XAI_BASE_URL=https://api.x.ai/v1

# OpenAI (optional away/home bench)
OPENAI_API_KEY=

# Google Gemini (GEMINI_API_KEY first, then GOOGLE_API_KEY)
GEMINI_API_KEY=
# GOOGLE_API_KEY=

# Meta Muse Glimmer — local OpenAI-compat (llama.cpp / LM Studio / vLLM). $0 tokens.
# Dummy key is enough for the health gate; llama-server ignores it.
MUSE_API_KEY=local
MUSE_BASE_URL=http://127.0.0.1:8080/v1
# Hosted Spark (token-billed) only if you set MUSE_BASE_URL=https://api.meta.ai/v1 and MODEL_API_KEY=
# Never default muse-spark-1.2-contributor (prompts used for training).

# Default xAI slugs when --home-provider / --away-provider is omitted
GRAPH_HOCKEY_COACH_MODEL=grok-4.5
GRAPH_HOCKEY_FAST_MODEL=grok-4.3
GRAPH_HOCKEY_AAR_MODEL=grok-4.5
# GRAPH_HOCKEY_COACH_MODEL=grok-4.6   # optional upgrade

GRAPH_HOCKEY_HITL=0
GRAPH_HOCKEY_MAX_PROMPT_TOKENS_PER_GAME=900000
GRAPH_HOCKEY_MAX_OUTPUT_TOKENS_PER_GAME=250000
GRAPH_HOCKEY_MAX_USD_PER_GAME=4.00
GRAPH_HOCKEY_MAX_CALLS_PER_TEAM=150
GRAPH_HOCKEY_EPOCH_TIMEOUT_MS=8000

# Test/CI only: shorten regulation so `gh simulate --no-llm` is not 36,000 ticks.
# GRAPH_HOCKEY_PERIOD_SECONDS=5
# GRAPH_HOCKEY_OT_SECONDS is optional; when period seconds is shortened, OT scales as 5:00/20:00.

# Localhost only. Never bind 0.0.0.0 in v1. Never send *_API_KEY to the browser.
# If 8787 is in use: set GRAPH_HOCKEY_HTTP_PORT to another free port.
GRAPH_HOCKEY_HTTP_HOST=127.0.0.1
GRAPH_HOCKEY_HTTP_PORT=8787

# LangSmith: ON automatically if either key is set (config.ts sets LANGSMITH_TRACING=true).
# Leave unset — the app and CI run without these.
# LANGSMITH_API_KEY=
# LANGCHAIN_API_KEY=
